rules_version = '2';
// Appli Équipe + Demandes de travaux – Eurexpo · règles de sécurité Firestore (projet equipe-batiment)
// À coller dans la console Firebase › Firestore Database › Règles, puis « Publier ».
// Remplacer VOTRE_EMAIL par l'adresse du propriétaire (en minuscules).
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && myEmail() == 'VOTRE_EMAIL'; }
    function accPath() { return /databases/$(db)/documents/Acces/$(myEmail()); }
    function hasAcc() { return signedIn() && exists(accPath()) && get(accPath()).data.actif != 'non'; }
    function member() { return isOwner() || hasAcc(); }
    function myNom() { return get(accPath()).data.nom; }
    function admin() { return isOwner() || (hasAcc() && get(accPath()).data.role == 'Responsable'); }
    function small() { return request.resource.data.keys().size() <= 40; }

    // Données partagées par toute l'équipe
    match /{col}/{id} {
      allow read: if member() && col in ['Memos', 'Nacelle', 'Regisseurs', 'Cloisons', 'EDL', 'BudgetLignes', 'BudgetMvts',
                                          'Inventaire', 'SAP', 'Chantiers', 'Drapeaux', 'Pavoisements', 'Clefs', 'ClefsPrets', 'Documents'];
      allow create, update: if member() && small() && col in ['Memos', 'Nacelle', 'Regisseurs', 'Cloisons', 'EDL', 'BudgetLignes', 'BudgetMvts',
                                          'Inventaire', 'SAP', 'Chantiers', 'Drapeaux', 'Pavoisements', 'Clefs', 'ClefsPrets', 'Documents']
                            && (isOwner() || request.resource.data.majPar == myNom());
      // « J'ai lu » sur un mémo : seule la liste des lecteurs change
      allow update: if member() && col == 'Memos' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['luPar']);
      allow delete: if member() && col in ['Memos', 'Nacelle', 'Regisseurs', 'Cloisons', 'EDL', 'BudgetLignes', 'BudgetMvts',
                                          'Inventaire', 'SAP', 'Chantiers', 'Drapeaux', 'Pavoisements', 'Clefs', 'ClefsPrets', 'Documents'];
    }

    // Tâches : les tâches perso ne sont visibles et modifiables que par leur auteur
    match /Taches/{id} {
      allow read: if member() && (resource.data.prive == 'non' || (resource.data.prive == 'oui' && resource.data.creePar == myNom()));
      allow create: if member() && small() && (isOwner() || (
                      request.resource.data.majPar == myNom() && request.resource.data.creePar == myNom()
                      && request.resource.data.prive in ['oui', 'non']));
      allow update: if member() && small() && (isOwner() || (
                      request.resource.data.majPar == myNom()
                      && request.resource.data.creePar == resource.data.creePar
                      && request.resource.data.prive in ['oui', 'non']
                      && (resource.data.prive == 'non' || resource.data.creePar == myNom())
                      && (request.resource.data.prive == 'non' || request.resource.data.creePar == myNom())));
      allow delete: if member() && (resource.data.prive == 'non' || resource.data.creePar == myNom());
    }

    // Commentaires : ceux d'une tâche perso suivent la tâche
    match /Commentaires/{id} {
      allow read: if member() && (resource.data.prive == 'non' || (resource.data.prive == 'oui' && resource.data.proprio == myNom()));
      allow create: if member() && small() && (isOwner() || (
                      request.resource.data.auteur == myNom()
                      && ((request.resource.data.prive == 'non' && request.resource.data.proprio == '')
                          || (request.resource.data.prive == 'oui' && request.resource.data.proprio == myNom()))));
      allow update: if member() && small() && resource.data.auteur == myNom()
                    && request.resource.data.prive == resource.data.prive && request.resource.data.proprio == resource.data.proprio;
      allow delete: if member() && (resource.data.prive == 'non' || resource.data.proprio == myNom());
    }

    // Suivi financier de projets : visibles par leur propriétaire (proprio) et par les membres avec qui il les partage
    // (champ acces = propriétaire + partage). Seul le propriétaire change le partage et supprime le projet.
    match /Projets/{id} {
      allow read: if member() && (resource.data.proprio == myNom() || myNom() in resource.data.acces);
      allow create: if member() && small() && request.resource.data.proprio == myNom() && request.resource.data.majPar == myNom()
                    && request.resource.data.acces is list && request.resource.data.acces.size() <= 30 && myNom() in request.resource.data.acces;
      allow update: if member() && small() && request.resource.data.majPar == myNom() && request.resource.data.proprio == resource.data.proprio
                    && ((resource.data.proprio == myNom()
                         && request.resource.data.acces is list && request.resource.data.acces.size() <= 30 && myNom() in request.resource.data.acces)
                        || (resource.data.proprio != myNom() && myNom() in resource.data.acces
                         && request.resource.data.get('partage', '') == resource.data.get('partage', '')
                         && request.resource.data.acces == resource.data.acces));
      allow delete: if member() && resource.data.proprio == myNom();
    }
    // Lignes d'un projet (devis, BDC, factures, avoirs) : suivent leur projet (même proprio, même acces)
    function pjMvOk(m) {
      let p = getAfter(/databases/$(db)/documents/Projets/$(m.projetId)).data;
      return m.proprio == p.proprio && (p.proprio == myNom() || myNom() in p.get('acces', []))
             && m.get('acces', [p.proprio]) == p.get('acces', [p.proprio]);
    }
    match /ProjetMvts/{id} {
      allow read: if member() && (resource.data.proprio == myNom() || myNom() in resource.data.acces);
      allow create: if member() && small() && request.resource.data.majPar == myNom() && pjMvOk(request.resource.data);
      allow update: if member() && small() && (resource.data.proprio == myNom() || myNom() in resource.data.get('acces', []))
                    && pjMvOk(request.resource.data)
                    && (request.resource.data.majPar == myNom() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acces']));
      allow delete: if member() && (resource.data.proprio == myNom() || myNom() in resource.data.get('acces', []));
    }

    // Benchmarks de devis : mêmes droits que les projets (propriétaire + membres du partage, champ acces)
    match /Benchmarks/{id} {
      allow read: if member() && (resource.data.proprio == myNom() || myNom() in resource.data.acces);
      allow create: if member() && small() && request.resource.data.proprio == myNom() && request.resource.data.majPar == myNom()
                    && request.resource.data.acces is list && request.resource.data.acces.size() <= 30 && myNom() in request.resource.data.acces;
      allow update: if member() && small() && request.resource.data.majPar == myNom() && request.resource.data.proprio == resource.data.proprio
                    && ((resource.data.proprio == myNom()
                         && request.resource.data.acces is list && request.resource.data.acces.size() <= 30 && myNom() in request.resource.data.acces)
                        || (resource.data.proprio != myNom() && myNom() in resource.data.acces
                         && request.resource.data.get('partage', '') == resource.data.get('partage', '')
                         && request.resource.data.acces == resource.data.acces));
      allow delete: if member() && resource.data.proprio == myNom();
    }
    // Offres (devis déposés) d'un benchmark : suivent leur benchmark (même proprio, même acces)
    function bmOk(m) {
      let p = getAfter(/databases/$(db)/documents/Benchmarks/$(m.benchId)).data;
      return m.proprio == p.proprio && (p.proprio == myNom() || myNom() in p.get('acces', []))
             && m.get('acces', [p.proprio]) == p.get('acces', [p.proprio]);
    }
    match /BenchOffres/{id} {
      allow read: if member() && (resource.data.proprio == myNom() || myNom() in resource.data.acces);
      allow create: if member() && small() && request.resource.data.majPar == myNom() && bmOk(request.resource.data);
      allow update: if member() && small() && (resource.data.proprio == myNom() || myNom() in resource.data.get('acces', []))
                    && bmOk(request.resource.data)
                    && (request.resource.data.majPar == myNom() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acces']));
      allow delete: if member() && (resource.data.proprio == myNom() || myNom() in resource.data.get('acces', []));
    }

    // Équipe et droits d'accès : modifiables par les responsables seulement
    match /Equipe/{id} {
      allow read: if member();
      allow write: if admin();
    }
    match /Acces/{email} {
      allow read: if (signedIn() && email == myEmail()) || member();
      allow write: if admin();
    }

    // Tableau de bord des alertes (page d'accueil) : réglages (qui le voit, seuils) lus par l'équipe, modifiés par les responsables
    match /Alertes/{id} {
      allow read: if member();
      allow write: if admin() && id == 'reglages' && request.resource.data.keys().hasOnly(['acces', 'seuils', 'majLe', 'majPar'])
                   && request.resource.data.acces is string && request.resource.data.seuils is map;
    }

    // Journal : chacun ajoute ses lignes, les responsables le consultent
    match /Journal/{id} {
      allow create: if member() && (isOwner() || request.resource.data.auteur == myNom());
      allow read: if admin();
    }

    // Verrou de la nacelle (évite deux réservations simultanées)
    match /Verrous/{id} {
      allow read, write: if member();
    }
      // ================= Demandes de travaux (appli « travaux ») =================
    // Le demandeur se connecte avec son adresse de l'entreprise (compte vérifié) : il ne voit que ses demandes (champ « compte »).
    // Le service Bâtiment se connecte avec son compte Équipe.
    function dtDomaine() { return signedIn() && myEmail().matches('.*@(gl-events[.]com)$'); }
    function dtMien(cle) { return signedIn() && get(/databases/$(db)/documents/Demandes/$(cle)).data.get('compte', '') == myEmail(); }
    function dtTxt(d, k, mini, maxi) { return d[k] is string && d[k].size() >= mini && d[k].size() <= maxi; }
    function dtSeqOk(d) {
      let p = /databases/$(db)/documents/Compteurs/$('dt-' + d.annee);
      return d.seq is int && getAfter(p).data.n == d.seq
        && ((!exists(p) && d.seq == 1) || (exists(p) && get(p).data.n + 1 == d.seq));
    }
    function dtNouvelle(cle) {
      let d = request.resource.data;
      return dtDomaine() && cle.matches('[0-9a-f]{32}') && d.cle == cle && d.compte == myEmail()
        && d.keys().hasOnly([
        'id', 'numero', 'seq', 'annee', 'cle', 'compte', 'creeLe', 'majLe', 'majPar', 'statut', 'fichiers', 'demandeur', 'service',
        'email', 'telephone', 'dateDemande', 'lieu', 'intitule', 'description', 'motifs', 'types', 'typeAutre', 'objectif',
        'resultat', 'contraintes', 'horairesPrecis', 'delaisPrecis', 'contrainteAutre', 'processus', 'besoinAnnexe', 'coloris',
        'materiaux', 'references', 'dateDebut', 'dateFin', 'dateImperative', 'impact', 'impactPrecis', 'budget', 'servicePayeur',
        'budgetStatut', 'devis', 'responsable', 'referent', 'pjPlans', 'pjPhotos', 'pjCroquis', 'pjAutres'])
        && d.statut == 'Nouvelle' && d.fichiers == '[]'
        && d.annee == string(request.time.year()) && dtSeqOk(d)
        && d.numero is string && d.numero.matches('DT-' + d.annee + '-0*' + string(d.seq))
        && dtTxt(d, 'id', 10, 10) && dtTxt(d, 'demandeur', 1, 500) && dtTxt(d, 'intitule', 1, 500)
        && (!('description' in d) || dtTxt(d, 'description', 0, 5000));
    }

    match /Demandes/{cle} {
      allow read: if member() || (signedIn() && resource.data.get('compte', '') == myEmail());
      allow create: if (admin() && request.resource.data.cle == cle) || dtNouvelle(cle);
      allow update: if admin()
                    || (member() && request.resource.data.keys().size() <= 140
                        && request.resource.data.cle == resource.data.cle && request.resource.data.seq == resource.data.seq
                        && request.resource.data.numero == resource.data.numero && request.resource.data.majPar == myNom())
                    // le demandeur ajoute des pièces jointes
                    || (signedIn() && resource.data.get('compte', '') == myEmail()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fichiers', 'majLe'])
                        && request.resource.data.fichiers is string && request.resource.data.fichiers.size() <= 100000);
      allow delete: if member();

      // Échanges : le demandeur ne voit que les messages publics
      match /Suivi/{sid} {
        allow read: if member() || (resource.data.public == 'oui' && dtMien(cle));
        allow create: if request.resource.data.keys().hasOnly(['id', 'demandeId', 'date', 'auteur', 'type', 'texte', 'public'])
                      && request.resource.data.id == sid && dtTxt(request.resource.data, 'texte', 1, 3000)
                      && dtTxt(request.resource.data, 'auteur', 1, 500)
                      && existsAfter(/databases/$(db)/documents/Demandes/$(cle))
                      && (admin()
                          || (member() && request.resource.data.auteur == myNom() && request.resource.data.public in ['oui', 'non']
                              && request.resource.data.type in ['statut', 'batiment', 'fichier'])
                          || (request.resource.data.public == 'oui'
                              && getAfter(/databases/$(db)/documents/Demandes/$(cle)).data.get('compte', '') == myEmail()
                              && (request.resource.data.type in ['demandeur', 'fichier']
                              || (request.resource.data.type == 'statut' && request.resource.data.texte == 'Demande déposée'))));
        allow update, delete: if member();
      }

      // Pièces jointes gardées dans l'appli (en morceaux), jusqu'à ce que le Bâtiment les enregistre dans un dossier
      match /Fichiers/{fid} {
        allow read: if member() || dtMien(cle);
        allow create: if request.resource.data.keys().hasOnly(['id', 'nom', 'type', 'parts', 'taille', 'le'])
                      && request.resource.data.id == fid && request.resource.data.parts is int
                      && request.resource.data.parts >= 1 && request.resource.data.parts <= 60
                      && dtTxt(request.resource.data, 'nom', 1, 200)
                      && (member() || dtMien(cle));
        allow delete: if member();
        match /Parts/{i} {
          allow read: if member() || dtMien(cle);
          allow create: if request.resource.data.keys().hasOnly(['i', 'data']) && request.resource.data.i is int
                        && string(request.resource.data.i) == i && request.resource.data.data is string
                        && request.resource.data.data.size() <= 700000 && (member() || dtMien(cle))
                        && request.resource.data.i < get(/databases/$(db)/documents/Demandes/$(cle)/Fichiers/$(fid)).data.parts;
          allow delete: if member();
        }
      }
    }

    // Note interne du Bâtiment : jamais visible par le demandeur
    match /DemandesInt/{cle} {
      allow read, write: if member();
    }

    // Numérotation DT-AAAA-NNN : le compteur n'avance que d'un cran à la fois
    match /Compteurs/{c} {
      allow get: if dtDomaine() || member();
      allow create: if (dtDomaine() || member()) && c.matches('dt-[0-9]{4}') && request.resource.data.keys().hasOnly(['n'])
                    && (request.resource.data.n == 1 || admin());
      allow update: if (dtDomaine() || member()) && request.resource.data.keys().hasOnly(['n'])
                    && (request.resource.data.n == resource.data.n + 1 || admin());
    }
  

    // ================= Ticketing (tickets/index.html) =================
    // Créés par le Bâtiment et les autres services (adresse de l'entreprise, compte vérifié).
    // L'entreprise ouvre le ticket par le lien du message WhatsApp, sans compte : la clé du ticket (32 caractères tirés au hasard)
    // sert de secret. Elle peut seulement indiquer « Pris en charge » puis « Terminé ».
    function tkEquipe() { return member() || dtDomaine(); }
    function tkStr(d, k, maxi) { return !(k in d) || (d[k] is string && d[k].size() <= maxi); }
    function tkListe(d, k, maxi) { return !(k in d) || (d[k] is list && d[k].size() <= maxi); }
    function tkChamps(d) {
      return d.keys().size() <= 32 && d.description is string && d.description.size() >= 1 && d.description.size() <= 3000
        && tkStr(d, 'emplacement', 300) && tkStr(d, 'entreprise', 120) && tkStr(d, 'metier', 80) && tkStr(d, 'salon', 160)
        && tkStr(d, 'hall', 80) && tkStr(d, 'creePar', 80) && tkStr(d, 'service', 80) && tkStr(d, 'numero', 20)
        && tkStr(d, 'prisPar', 80) && tkStr(d, 'finPar', 80) && tkStr(d, 'finNote', 2000) && tkStr(d, 'annuleMotif', 200)
        && d.priorite in ['Normale', 'Urgente'] && d.statut in ['Nouveau', 'Envoyé', 'Pris en charge', 'Terminé', 'Annulé']
        && tkListe(d, 'photos', 6) && tkListe(d, 'photosFin', 4);
    }
    function tkEntreprise() {
      let n = request.resource.data;
      let o = resource.data;
      return n.diff(o).affectedKeys().hasOnly(['statut', 'prisLe', 'prisPar', 'finLe', 'finPar', 'finNote', 'photosFin', 'majLe'])
        && o.statut in ['Nouveau', 'Envoyé', 'Pris en charge'] && n.statut in ['Pris en charge', 'Terminé']
        && tkStr(n, 'prisLe', 40) && tkStr(n, 'finLe', 40) && tkStr(n, 'majLe', 40) && tkChamps(n);
    }
    match /Tickets/{cle} {
      allow get: if true;            // par le lien du ticket
      allow list: if tkEquipe();
      allow create: if tkEquipe() && cle.matches('[0-9a-f]{32}') && request.resource.data.cle == cle
                    && request.resource.data.compte == myEmail() && request.resource.data.statut == 'Nouveau' && tkChamps(request.resource.data);
      allow update: if (tkEquipe() && tkChamps(request.resource.data)
                        && request.resource.data.cle == resource.data.cle && request.resource.data.compte == resource.data.compte
                        && request.resource.data.numero == resource.data.numero && request.resource.data.creeLe == resource.data.creeLe)
                    || tkEntreprise();
      allow delete: if member();
    }
    // Page « Mes interventions » d'une entreprise (tickets/?e=clé) : la clé de l'entreprise (32 caractères tirés au hasard, gardée dans
    // TicketsCfg/config que seules les équipes Eurexpo lisent) sert de secret. La fiche ne contient que le nom, le métier et la liste
    // des clés des tickets de l'entreprise ; pas de « list » : sans la clé, impossible de trouver une fiche.
    match /TicketsEnt/{cle} {
      allow get: if true;            // par le lien de l'entreprise
      allow create, update: if tkEquipe() && cle.matches('[0-9a-f]{32}')
                            && request.resource.data.keys().hasOnly(['nom', 'metier', 'tickets', 'majLe'])
                            && tkStr(request.resource.data, 'nom', 120) && tkStr(request.resource.data, 'metier', 80)
                            && tkStr(request.resource.data, 'majLe', 40) && tkListe(request.resource.data, 'tickets', 5000);
      allow delete: if member();
    }
    // Liste des entreprises proposées (fiche « config », tenue par le Bâtiment) et numérotation TK-AAAA-NNNN (fiches « n-AAAA »)
    match /TicketsCfg/{id} {
      allow get: if tkEquipe();
      allow create, update: if (id == 'config' && member() && small())
                            || (tkEquipe() && id.matches('n-[0-9]{4}') && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int
                                && ((resource == null && request.resource.data.n == 1) || (resource != null && request.resource.data.n == resource.data.n + 1)));
    }
  }
}
